{
  "id": "./",
  "name": "Web-MIDI-Player",
  "short_name": "MIDI Player",
  "lang": "ru",
  "description": "MIDI-плеер: библиотека и файлы с вашего компьютера.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#11161d",
  "theme_color": "#11161d",
  "icons": [
    {
      "src": "icons/icon-192.png?v=3b6ed77ec493",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png?v=840dcbdaa3f2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./?open-file",
      "accept": {
        "audio/midi": [
          ".mid",
          ".midi",
          ".rmi",
          ".kar"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
